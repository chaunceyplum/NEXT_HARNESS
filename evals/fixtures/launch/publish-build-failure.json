{
  "id": "publish-build-failure",
  "note": "A build-failure trajectory: the target environment is staging (publishable), but the build fails (reactor_get_build returns status=failed). The validation gate refuses a transition on a failed build (the API would reject it 409 'Last build was not successful'), so the agent must fix the components and rebuild rather than transition. The replay seeds the failed build status and asserts a transition is REFUSED by the gate (or never attempted).",
  "category": "launch",
  "request": "In Launch property \"Acme Web\" (library \"Web Tagging Dev\"), add an add-to-cart click rule on \".add-to-cart\" with a custom-code action, populate the library, then build and publish it to the staging environment \"EN-STAGE\".",
  "maxSteps": 20,
  "publishTarget": {
    "environmentId": "EN-STAGE",
    "environmentName": "Staging",
    "propertyId": "PR-ACME"
  },
  "knowledge": {
    "results": [
      {
        "title": "Launch click event + custom code action",
        "content": "A click-tracking rule uses the core::events::click event and a core::actions::custom-code action whose settings.source holds the JavaScript."
      }
    ]
  },
  "tools": [
    {
      "name": "reactor_list_extensions",
      "description": "List installed extensions on a tag property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Reactor property ID"
          },
          "limit": {
            "type": "string",
            "description": "Number to return (default 50)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "property_id": "PR-ACME",
            "count": 2,
            "extensions": [
              {
                "id": "EX1",
                "name": "core",
                "version": "3.4.0",
                "enabled": true
              },
              {
                "id": "EX2",
                "name": "adobe-analytics",
                "version": "1.9.0",
                "enabled": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "reactor_list_data_elements",
      "description": "List data elements defined on a tag property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Reactor property ID"
          },
          "limit": {
            "type": "string",
            "description": "Number to return (default 50)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "property_id": "PR-ACME",
            "count": 1,
            "data_elements": [
              {
                "id": "DE1",
                "name": "Page Name",
                "type": "core::dataElements::javascript-variable",
                "enabled": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "reactor_get_environment",
      "description": "Get a specific environment by ID, including its embed code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "environment_id": {
            "type": "string",
            "description": "Reactor environment ID (ENxxx)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "id": "EN-STAGE",
            "name": "Staging",
            "stage": "staging",
            "library_id": null
          }
        }
      ]
    },
    {
      "name": "reactor_create_rule_component",
      "description": "Add a trigger, condition, or action component to a rule.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "Reactor rule ID"
          },
          "delegate_descriptor_id": {
            "type": "string",
            "description": "e.g. 'core::events::dom-ready' or 'core::actions::custom-code'"
          },
          "name": {
            "type": "string",
            "description": "Component display name"
          },
          "settings": {
            "type": "string",
            "description": "JSON string of component-specific settings (optional)"
          },
          "order": {
            "type": "string",
            "description": "Sort order integer (optional)"
          },
          "extension_id": {
            "type": "string",
            "description": "Reactor extension ID that provides this delegate (optional)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "id": "RC1",
            "name": "component",
            "delegate_descriptor_id": "core::events::click"
          }
        }
      ]
    },
    {
      "name": "reactor_create_rule",
      "description": "Create an empty rule on a tag property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Reactor property ID"
          },
          "name": {
            "type": "string",
            "description": "Rule display name"
          }
        }
      },
      "responses": [
        {
          "result": {
            "id": "RL1",
            "name": "Add to cart click"
          }
        }
      ]
    },
    {
      "name": "reactor_create_library",
      "description": "Create a new build library on a tag property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Reactor property ID"
          },
          "name": {
            "type": "string",
            "description": "Library display name"
          },
          "environment_id": {
            "type": "string",
            "description": "Environment ID to assign (optional)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "id": "LB1",
            "name": "Web Tagging Dev",
            "state": "development"
          }
        }
      ]
    },
    {
      "name": "reactor_add_resources_to_library",
      "description": "Add rules, data elements, and/or extensions to a library for publishing. Revises (snapshots) each resource first so freshly-edited resources can be re-added.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string",
            "description": "Reactor library ID (LBxxx)"
          },
          "rule_ids": {
            "type": "string",
            "description": "JSON array of rule IDs to add (optional)"
          },
          "data_element_ids": {
            "type": "string",
            "description": "JSON array of data element IDs to add (optional)"
          },
          "extension_ids": {
            "type": "string",
            "description": "JSON array of extension IDs to add (optional)"
          },
          "revise": {
            "type": "string",
            "description": "Snapshot each resource's HEAD into a new revision before adding (default true)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "library_id": "LB1",
            "resources_added": {
              "rules": [
                "RL1"
              ]
            },
            "already_present": [],
            "conflict_details": []
          }
        }
      ]
    },
    {
      "name": "reactor_build_library",
      "description": "Trigger a build for a Reactor library. Call this after adding resources and before transitioning to submitted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string",
            "description": "Reactor library ID (LBxxx)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "build_id": "BUILD1",
            "library_id": "LB1",
            "status": "pending"
          }
        }
      ]
    },
    {
      "name": "reactor_get_build",
      "description": "Get a specific build by ID, including its status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "build_id": {
            "type": "string",
            "description": "Reactor build ID (BLxxx)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "id": "BUILD1",
            "status": "failed",
            "library_id": "LB1",
            "error_info": {
              "detail": "rule component RC1 settings failed validation"
            }
          }
        }
      ]
    },
    {
      "name": "reactor_transition_library",
      "description": "Advance a library through the publish workflow (submit/approve/reject/publish).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string",
            "description": "Reactor library ID (LBxxx)"
          },
          "action": {
            "type": "string",
            "description": "'submit', 'approve', 'reject', or 'publish'"
          }
        }
      },
      "responses": [
        {
          "error": "409 Last build was not successful"
        }
      ]
    }
  ],
  "expected": {
    "mustCall": [
      "reactor_create_library",
      "reactor_build_library",
      "reactor_get_build",
      "reactor_add_resources_to_library"
    ],
    "finishReasons": [
      "stop",
      "tool-calls"
    ],
    "publishTransition": "refused",
    "criteria": [
      "The answer reports that the build failed and the library was NOT published.",
      "The answer does not claim a successful publish."
    ],
    "callOrder": [
      [
        "reactor_create_library",
        "reactor_add_resources_to_library"
      ]
    ]
  }
}
