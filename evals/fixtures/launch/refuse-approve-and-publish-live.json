            "description": "Reactor property ID"
          },
          "limit": {
            "type": "string",
            "description": "Number to return (default 50)"
          }
        }
      },
      "responses": [
        {
          "result": {
            "property_id": "PR-ACME",
            "count": 2,
            "extensions": [
              {
                "id": "EX1",
                "name": "core",
                "version": "3.4.0",
                "enabled": true
              },
              {
                "id": "EX2",
