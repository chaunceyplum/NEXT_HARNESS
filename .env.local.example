# Copy this file to .env.local (already gitignored) and fill in what you need.
# Restart `npm run dev` after editing — Next.js only reads this at server start.
# Full reference: ENVIRONMENT_VARIABLES.md

# ── MCP connection (required) ──────────────────────────────────────────────
MCP_ENDPOINT_URL=https://your-endpoint.execute-api.us-east-1.amazonaws.com/mcp
# Only if your API Gateway stage enforces auth (a bare 403 Forbidden with no
# JSON body on the "MCP tool catalog" stage is the sign you need one of these):
# MCP_API_KEY=<api-gateway-key>          # sent as x-api-key
# MCP_AUTH_TOKEN=<token>                 # sent as Authorization: Bearer <token>

# ── GitHub read access (optional — enables github_read_file/
#    github_list_directory, lib/llm/local-tools.ts) ─────────────────────────
# A fine-grained PAT with read-only "Contents" access to whichever repo(s)
# the agent should be able to read before proposing a code change via
# msb_github_commit_code. Leave unset to leave those two tools non-functional
# (they'll fail with a clear "not configured" error rather than vanishing).
# GITHUB_TOKEN=github_pat_...

# ── Chat model: Bedrock (DEFAULT — bedrock:balanced, no Anthropic key needed)
# Requires IAM creds with bedrock:InvokeModel AND model access enabled in the
# AWS Console -> Bedrock -> Model access (separate from IAM, opt-in per model).
# Ships with working default model IDs below; override if your account needs
# different ones (get real model IDs for your account with:
#   aws bedrock list-foundation-models --query 'modelSummaries[].modelId'
# — some accounts need cross-region inference profile IDs instead, prefixed
# like "us.anthropic...").
AWS_REGION=us-east-2
# Uncomment and fill in, or leave commented to use the default AWS credential
# chain (EC2 instance role, ECS/EKS task role, SSO, ~/.aws). Never leave the
# "..." placeholders active: they get sent to AWS as a real key.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...                  # only for temporary/STS credentials
# BEDROCK_CHEAP_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0       # default shown
# BEDROCK_BALANCED_MODEL_ID=anthropic.claude-sonnet-5   # default shown
# BEDROCK_EXPENSIVE_MODEL_ID=anthropic.claude-opus-4-8      # default shown
# DEFAULT_MODEL=bedrock:balanced         # default; or bedrock:cheap | bedrock:expensive

# ── Chat model: Anthropic direct (optional alternative to Bedrock) ────────
# Setting only the key is not enough: without DEFAULT_MODEL everything (the
# app and the evals) still goes to Bedrock.
# ANTHROPIC_API_KEY=sk-ant-...           # get one at console.anthropic.com
# DEFAULT_MODEL=anthropic:sonnet         # anthropic:haiku | anthropic:sonnet | anthropic:sonnet-5-5 | anthropic:opus | anthropic:opus-5-5

# ── Chat model: OpenAI (optional) ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_CHEAP_MODEL_ID=gpt-4o-mini
# OPENAI_BALANCED_MODEL_ID=gpt-4o

# ── Tool-shortlisting embeddings (optional — falls back to keyword matching
#    automatically if unset or if the call fails, so this is not required to
#    get a working harness) ─────────────────────────────────────────────────
# EMBEDDING_PROVIDER=openai              # or "bedrock" — auto-detected if unset
# EMBEDDING_MODEL_ID=text-embedding-3-small

# ── Deployment context (optional — reduces discovery-step waste) ──────────
# A short free-form string describing the defaults for this deployment. Injected
# into the system prompt so the agent doesn't spend steps listing sandboxes,
# Launch properties, or repos to discover what it's working with.
# HARNESS_CONTEXT="AEP sandbox: prod | Launch property: PR1234abcd | GitHub repo: myorg/web-tags"

# ── Extended thinking (optional — Claude on Anthropic/Bedrock only) ─────
# Enables the model's internal reasoning before it responds. Minimum 1024.
# On Haiku 4.5 and older Claude models this is the token budget (8000–16000 is
# a good start for multi-step tasks). Newer models (Sonnet 5, Opus 4.7+, Opus
# 5.x) reject fixed budgets, so any value here just turns on adaptive thinking.
# Ignored for OpenAI and non-Claude Bedrock models.
# THINKING_BUDGET_TOKENS=8000

# ── Tool policy (default: full access) ────────────────────────────────────
# BUILD_POLICY=read-only    # removes all write/destructive tools — model structurally cannot call them
# TOOL_DRY_RUN=true         # destructive tools describe what they would do, but don't execute
# Destructive calls (delete/abort/merge PR/privacy job) otherwise pause for
# Approve/Deny on the home page; this is how long they wait before being denied.
# APPROVAL_TIMEOUT_MS=600000

# ── Tool catalog scope (default: Adobe-only) ───────────────────────────────
# By default the agent only ever sees Adobe tools (AEP/CJA/AJO/Reactor) —
# AWS, Databricks, Snowflake, Braze, Zeta, and cross-platform search tools
# are filtered out of the catalog entirely. Set to false to bring them back.
# ADOBE_TOOLS_ONLY=false

# ── RAG judge (default: on) ────────────────────────────────────────────────
# Every search_adobe_knowledge/search_all_agents call is independently
# scored by a second, cheap LLM call for relevance/sufficiency — see
# lib/llm/rag-judge.ts. The judge assumes the knowledge base's own
# reranking has already ordered results well; it grades whether what came
# back is actually good enough to act on, not whether it's in the right
# order. A judge failure never fails the underlying RAG call.
# RAG_JUDGE_ENABLED=false
# RAG_JUDGE_MODEL=bedrock:cheap          # defaults to DEFAULT_MODEL if unset

# ── Evals (npm run eval:*, see evals/README.md) ───────────────────────────
# EVAL_MODEL=bedrock:cheap               # model under test for eval:agent; defaults to DEFAULT_MODEL
# EVAL_JUDGE_MODEL=bedrock:expensive     # grades rubric questions; defaults to the strongest tier of DEFAULT_MODEL's provider
# EVAL_JUDGE_FALLBACK_MODEL=anthropic:opus  # judge to retry on if the main judge refuses; defaults to next-strongest on the same provider
# EVAL_TRIALS=5                          # runs per fixture, for pass@k / pass^k (default 1, max 20)
# MODEL_PRICING_JSON='{"bedrock:balanced":{"input":2,"output":10}}'  # USD per 1M tokens, overrides list prices for cost-per-success
